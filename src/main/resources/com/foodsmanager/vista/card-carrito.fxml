<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="96.0" minWidth="101.0" prefHeight="377.0" prefWidth="592.0" styleClass="barra-superior" stylesheets="@tema.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.foodsmanager.controlador.CardCarritoController">
   <children>
      <VBox prefHeight="367.0" prefWidth="583.0" styleClass="tarjeta-pedido">
         <children>
            <ImageView fx:id="imgProducto" fitHeight="199.0" fitWidth="562.0" pickOnBounds="true" preserveRatio="true" />
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <VBox prefHeight="100.0" prefWidth="382.0" styleClass="tarjeta-pedido">
                     <children>
                        <Label fx:id="lblNombre" styleClass="etiqueta-formulario" stylesheets="@tema.css" text="Nombre:" />
                        <Label fx:id="lblDescripcion" styleClass="etiqueta-formulario" text="Describción: ">
                           <opaqueInsets>
                              <Insets />
                           </opaqueInsets>
                        </Label>
                        <Label fx:id="lblPrecio" styleClass="etiqueta-formulario" text="Precio unitario: " />
                     </children>
                  </VBox>
                  <Region prefHeight="100.0" prefWidth="22.0" HBox.hgrow="ALWAYS" />
                  <VBox prefHeight="122.0" prefWidth="184.0" styleClass="tarjeta-pedido">
                     <children>
                        <HBox prefHeight="56.0" prefWidth="156.0">
                           <children>
                              <Button fx:id="btnRestar" minHeight="19.0" minWidth="27.0" mnemonicParsing="false" onAction="#disminuirCantidad" prefHeight="19.0" prefWidth="27.0" styleClass="boton-cantidad" text="-" />
                              <Label fx:id="lblCantidad" prefHeight="18.0" prefWidth="95.0" styleClass="etiqueta-formulario" text="Cantidad: 1" />
                              <Button fx:id="btnSumar" mnemonicParsing="false" onAction="#aumentarCantidad" prefHeight="37.0" prefWidth="42.0" styleClass="boton-cantidad" text="+" />
                           </children>
                        </HBox>
                        <Label fx:id="lblSubtotal" prefHeight="38.0" prefWidth="106.0" styleClass="etiqueta-formulario" text="subtotal:" />
                        <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminarProducto" styleClass="boton-eliminar" text="Eliminar" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</HBox>
