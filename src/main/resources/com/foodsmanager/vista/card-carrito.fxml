<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<HBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="377.0" minWidth="101.0" prefHeight="-1.0" prefWidth="592.0" styleClass="carrito-tarjeta-moderna" stylesheets="@tema.css" fx:controller="com.foodsmanager.controlador.CardCarritoController">
  <children>
    <VBox prefHeight="-1.0" prefWidth="592.0" styleClass="carrito-superficie" maxWidth="Infinity" alignment="TOP_CENTER" spacing="16" HBox.hgrow="ALWAYS">
      <children>
        <ImageView fx:id="imgProducto" fitHeight="168.0" fitWidth="554.0" pickOnBounds="true" preserveRatio="true" smooth="true" styleClass="carrito-imagen"/>
        <HBox prefHeight="-1.0" prefWidth="554.0" alignment="CENTER_LEFT" spacing="16">
          <children>
            <VBox prefHeight="-1.0" prefWidth="330.0" styleClass="carrito-informacion" minWidth="0" maxWidth="Infinity" spacing="8" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
              <children>
                <Label fx:id="lblNombre" styleClass="carrito-nombre" stylesheets="@tema.css" text="Nombre:" wrapText="true" maxWidth="Infinity" minHeight="-Infinity"/>
                <Label fx:id="lblDescripcion" styleClass="carrito-descripcion" text="Descripción:" wrapText="true" maxWidth="Infinity" minHeight="-Infinity">
                  <opaqueInsets>
                    <Insets/>
                  </opaqueInsets>
                </Label>
                <Label fx:id="lblPrecio" styleClass="carrito-precio" text="Precio unitario: " wrapText="true" maxWidth="Infinity" minHeight="-Infinity"/>
              </children>
            </VBox>
            <Region prefHeight="0" prefWidth="0" HBox.hgrow="ALWAYS" minWidth="0" maxWidth="0"/>
            <VBox prefHeight="-1.0" prefWidth="188.0" styleClass="carrito-controles" minWidth="188.0" maxWidth="188.0" spacing="8" alignment="CENTER">
              <children>
                <HBox prefHeight="32.0" prefWidth="160.0" alignment="CENTER" spacing="4">
                  <children>
                    <Button fx:id="btnRestar" minHeight="32.0" minWidth="32.0" mnemonicParsing="false" onAction="#disminuirCantidad" prefHeight="32.0" prefWidth="32.0" styleClass="boton-cantidad" text="-" maxWidth="32.0" maxHeight="32.0"/>
                    <Label fx:id="lblCantidad" prefHeight="32.0" prefWidth="88.0" styleClass="carrito-cantidad" text="Cantidad: 1" minWidth="88.0" maxWidth="88.0" alignment="CENTER"/>
                    <Button fx:id="btnSumar" mnemonicParsing="false" onAction="#aumentarCantidad" prefHeight="32.0" prefWidth="32.0" styleClass="boton-cantidad" text="+" minWidth="32.0" maxWidth="32.0" minHeight="32.0" maxHeight="32.0"/>
                  </children>
                </HBox>
                <Label fx:id="lblSubtotal" prefHeight="30.0" prefWidth="162.0" styleClass="carrito-subtotal" text="Subtotal:" maxWidth="Infinity" alignment="CENTER"/>
                <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminarProducto" styleClass="boton-eliminar" text="Eliminar" maxWidth="Infinity"/>
              </children>
            </VBox>
          </children>
        </HBox>
      </children>
    </VBox>
  </children>
</HBox>
