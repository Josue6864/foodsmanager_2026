<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="950.0" styleClass="pantalla-principal" stylesheets="@tema.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.foodsmanager.controlador.ControladorProducto">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="barra-superior">

            <padding>
                <Insets bottom="16.0" left="24.0" right="24.0" top="16.0" />
            </padding>

            <Label styleClass="marca" text="FoodsManager" />
         <Button fx:id="btnCarrito" mnemonicParsing="false" onAction="#abrirCarrito" styleClass="boton-secundario" text="Ver carrito" />

            <Region HBox.hgrow="ALWAYS" />

            <Button onAction="#volverRestaurantes" styleClass="boton-secundario" text="Volver a restaurantes" />

        </HBox>
    </top>

    <center>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-transparente">

            <content>

                <VBox alignment="TOP_CENTER" spacing="24.0">

                    <padding>
                        <Insets bottom="38.0" left="35.0" right="35.0" top="38.0" />
                    </padding>

                    <Label fx:id="etiquetaRestaurante" styleClass="titulo-principal" text="Productos" />

                    <Label styleClass="subtitulo" text="Productos disponibles del restaurante seleccionado." wrapText="true" />

                    <Label fx:id="etiquetaSinProductos" managed="false" styleClass="subtitulo" text="Este restaurante no tiene productos disponibles." visible="false" />

                    <FlowPane fx:id="contenedorProductos" alignment="TOP_CENTER" hgap="22.0" prefWrapLength="800.0" vgap="22.0" />

                </VBox>

            </content>

        </ScrollPane>

    </center>

    <bottom>

        <HBox alignment="CENTER" styleClass="pie-pagina">

            <padding>
                <Insets bottom="14.0" left="20.0" right="20.0" top="14.0" />
            </padding>

            <Label text="FoodsManager 2026" />

        </HBox>

    </bottom>

</BorderPane>
