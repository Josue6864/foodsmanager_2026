                        <Region prefHeight="102.0" prefWidth="27.0" />
                        <Button fx:id="btnConfirmarPago" mnemonicParsing="false" onAction="#confirmarPedido" styleClass="boton-pagar" stylesheets="@tema.css" text="Confirmar Pago" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
