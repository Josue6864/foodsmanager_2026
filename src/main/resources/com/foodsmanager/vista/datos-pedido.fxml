<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity"
            maxWidth="-Infinity"
            minHeight="-Infinity"
            minWidth="-Infinity"
            prefHeight="641.0"
            prefWidth="806.0"
            styleClass="contenedor-principal"
            stylesheets="@tema.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.foodsmanager.controlador.DatosPedidoController">

    <center>
        <StackPane prefHeight="646.0"
                   prefWidth="809.0"
                   styleClass="pantalla-login"
                   style="-fx-background-color: #f4f5fa;"
                   BorderPane.alignment="CENTER">

            <children>
                <VBox alignment="TOP_CENTER"
                      maxHeight="-Infinity"
                      maxWidth="-Infinity"
                      prefHeight="551.0"
                      prefWidth="610.0"
                      spacing="18.0"
                      styleClass="tarjeta-login"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 18px; -fx-border-color: #e5e7eb; -fx-border-width: 1px; -fx-border-radius: 18px; -fx-effect: dropshadow(gaussian, rgba(79,70,229,0.12), 18, 0.1, 0, 5);">

                    <children>
                        <Label styleClass="marca-login"
                               style="-fx-text-fill: #4338ca; -fx-font-size: 30px; -fx-font-weight: bold;"
                               text="FoodsManager" />

                        <VBox prefHeight="405.0" prefWidth="540.0">
                            <children>
                                <Label styleClass="etiqueta-formulario"
                                       style="-fx-text-fill: #111827; -fx-font-size: 18px; -fx-font-weight: bold;"
                                       text="Datos para recoger el pedido" />

                                <Label styleClass="subtitulo"
                                       style="-fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-font-weight: bold;"
                                       text="No necesitas crear una cuenta" />

                                <Separator prefHeight="24.0"
                                           prefWidth="530.0" />

                                <Label prefHeight="28.0"
                                       prefWidth="164.0"
                                       styleClass="etiqueta-formulario"
                                       style="-fx-text-fill: #374151; -fx-font-size: 13px; -fx-font-weight: bold;"
                                       text="Nombre" />

                                <TextField fx:id="txtNombre"
                                           promptText="Nombre completo:"
                                           styleClass="campo-login"
                                           stylesheets="@tema.css"
                                           style="-fx-background-color: #FFFFFF; -fx-background-radius: 10px; -fx-border-color: #d1d5db; -fx-border-width: 1px; -fx-border-radius: 10px; -fx-text-fill: #111827; -fx-font-size: 13px; -fx-padding: 4 10 4 10; -fx-focus-color: #818cf8; -fx-faint-focus-color: transparent;" />

                                <Label prefHeight="34.0"
                                       prefWidth="164.0"
                                       styleClass="etiqueta-formulario"
                                       style="-fx-text-fill: #374151; -fx-font-size: 13px; -fx-font-weight: bold;"
                                       text="Teléfono" />

                                <TextField fx:id="txtTelefono"
                                           promptText="Teléfono:"
                                           styleClass="campo-login"
                                           style="-fx-background-color: #FFFFFF; -fx-background-radius: 10px; -fx-border-color: #d1d5db; -fx-border-width: 1px; -fx-border-radius: 10px; -fx-text-fill: #111827; -fx-font-size: 13px; -fx-padding: 4 10 4 10; -fx-focus-color: #818cf8; -fx-faint-focus-color: transparent;" />

                                <Label prefHeight="30.0"
                                       prefWidth="260.0"
                                       styleClass="etiqueta-formulario"
                                       style="-fx-text-fill: #374151; -fx-font-size: 13px; -fx-font-weight: bold;"
                                       text="Nombre de quien recogerá" />

                                <TextField fx:id="txtPersonaRecoge"
                                           promptText="Nombre de quien recogerá:"
                                           styleClass="campo-login"
                                           style="-fx-background-color: #FFFFFF; -fx-background-radius: 10px; -fx-border-color: #d1d5db; -fx-border-width: 1px; -fx-border-radius: 10px; -fx-text-fill: #111827; -fx-font-size: 13px; -fx-padding: 4 10 4 10; -fx-focus-color: #818cf8; -fx-faint-focus-color: transparent;" />

                                <Label prefHeight="30.0"
                                       prefWidth="260.0"
                                       styleClass="etiqueta-formulario"
                                       style="-fx-text-fill: #374151; -fx-font-size: 13px; -fx-font-weight: bold;"
                                       text="Hora aproximada de recogida" />

                                <ComboBox fx:id="cmbHoraRecogida"
                                          prefHeight="25.0"
                                          prefWidth="242.0"
                                          promptText="hora aproximada de recogida"
                                          style="-fx-background-color: #FFFFFF; -fx-background-radius: 10px; -fx-border-color: #d1d5db; -fx-border-width: 1px; -fx-border-radius: 10px; -fx-font-size: 13px; -fx-focus-color: #818cf8; -fx-faint-focus-color: transparent;" />

                                <Label prefHeight="27.0"
                                       prefWidth="164.0"
                                       styleClass="etiqueta-formulario"
                                       style="-fx-text-fill: #374151; -fx-font-size: 13px; -fx-font-weight: bold;"
                                       text="Indicaciones adicionales" />

                                <TextArea fx:id="txtIndicaciones"
                                          prefHeight="187.0"
                                          prefWidth="540.0"
                                          promptText="Indicaciones adicionales"
                                          styleClass="campo-login"
                                          style="-fx-control-inner-background: #FFFFFF; -fx-background-color: #d1d5db, #FFFFFF; -fx-background-insets: 0, 1; -fx-background-radius: 10px, 9px; -fx-text-fill: #111827; -fx-font-size: 13px; -fx-focus-color: #818cf8; -fx-faint-focus-color: transparent;" />
                            </children>
                        </VBox>

                        <HBox prefHeight="42.0" prefWidth="530.0">
                            <children>
                                <Region prefHeight="102.0"
                                        prefWidth="222.0" />

                                <Button fx:id="btnRegresarCarrito"
                                        mnemonicParsing="false"
                                        onAction="#volverCarrito"
                                        styleClass="boton-regresar"
                                        style="-fx-background-color: #eef2ff; -fx-text-fill: #4338ca; -fx-border-color: #a5b4fc; -fx-border-width: 1.5px; -fx-border-radius: 12px; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 12px; -fx-padding: 8 16 8 16; -fx-cursor: hand; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;"
                                        text="Regresar al carrito" />

                                <Region prefHeight="102.0"
                                        prefWidth="27.0" />

                                <Button fx:id="btnConfirmarPago"
                                        mnemonicParsing="false"
                                        onAction="#confirmarPedido"
                                        styleClass="boton-pagar"
                                        stylesheets="@tema.css"
                                        style="-fx-background-color: linear-gradient(to bottom right, #4f46e5, #4338ca); -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 12px; -fx-padding: 8 16 8 16; -fx-cursor: hand; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;"
                                        text="Confirmar Pago" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane>