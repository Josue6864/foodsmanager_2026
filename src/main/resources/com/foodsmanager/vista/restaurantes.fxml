<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600" prefWidth="950" styleClass="pantalla-principal"
            stylesheets="@tema.css" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.foodsmanager.controlador.ControladorRestaurante">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="barra-superior">
            <padding><Insets top="16" right="24" bottom="16" left="24"/></padding>
            <Label text="FoodsManager" styleClass="marca"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="botonIniciarSesion" onAction="#abrirLogin"
                    text="Iniciar sesión como administrador" styleClass="boton-secundario"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-transparente">
            <content>
                <VBox alignment="TOP_CENTER" spacing="24" styleClass="seccion-restaurantes">
                    <padding><Insets top="38" right="35" bottom="38" left="35"/></padding>
                    <Label text="Restaurantes disponibles" styleClass="titulo-principal" wrapText="true"/>
                    <Label text="Selecciona un restaurante para consultar sus productos." styleClass="subtitulo" wrapText="true"/>
                    <Button text="Actualizar restaurantes" onAction="#cargarRestaurantes" styleClass="boton-secundario"/>
                    <Label fx:id="etiquetaMensaje" wrapText="true" visible="false" managed="false"/>
                    <TilePane fx:id="contenedorRestaurantes" alignment="CENTER"
                              hgap="22" prefColumns="3" vgap="22"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" styleClass="pie-pagina">
            <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>
            <Label text="FoodsManager 2026"/>
        </HBox>
    </bottom>
</BorderPane>
