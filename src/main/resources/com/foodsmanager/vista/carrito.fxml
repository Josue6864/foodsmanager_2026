<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" prefHeight="600.0" prefWidth="950.0" styleClass="contenedor-principal, carrito-moderno" stylesheets="@tema.css" fx:controller="com.foodsmanager.controlador.CarritoController">
  <center>
    <ScrollPane fx:id="scrollCarrito" fitToWidth="true" hbarPolicy="NEVER" prefHeight="200.0" prefWidth="200.0" styleClass="scroll-carrito" BorderPane.alignment="CENTER">
      <content>
        <TilePane fx:id="contenedorCarrito" alignment="TOP_CENTER" hgap="18.0" prefColumns="3" prefHeight="395.0" prefRows="2" prefWidth="950.0" styleClass="contenedor-cards-carrito" vgap="18.0"/>
      </content>
    </ScrollPane>
  </center>
  <bottom>
    <HBox prefHeight="-1.0" prefWidth="950.0" BorderPane.alignment="CENTER" styleClass="carrito-pie" alignment="CENTER_RIGHT">
      <children>
        <Region prefHeight="0" prefWidth="0" minWidth="0" HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnVaciarCarrito" mnemonicParsing="false" onAction="#vaciarCarrito" prefHeight="40.0" prefWidth="165.0" styleClass="boton-eliminar" text="Vaciar carrito" minWidth="165.0"/>
        <Region prefHeight="0" prefWidth="12.0" minWidth="12.0" maxWidth="12.0"/>
        <Button fx:id="btnContinuarPago" mnemonicParsing="false" onAction="#continuarPago" styleClass="boton-pagar" text="Continuar al pago" prefHeight="40.0" prefWidth="185.0" minWidth="185.0"/>
      </children>
    </HBox>
  </bottom>
  <top>
    <VBox prefHeight="-1.0" prefWidth="950.0" styleClass="encabezado-carrito" BorderPane.alignment="CENTER" spacing="10.0">
      <children>
        <HBox prefHeight="-1.0" prefWidth="200.0" alignment="CENTER_LEFT">
          <children>
            <Label styleClass="marca, carrito-marca" text="FoodsManager"/>
            <Region prefHeight="0" prefWidth="0" HBox.hgrow="ALWAYS" minWidth="0"/>
            <ComboBox fx:id="cmbNavegacion" onAction="#navegarDesdeMenu" prefWidth="190.0" promptText="Ir a..." styleClass="combo-navegacion"/>
          </children>
        </HBox>
        <HBox prefHeight="-1.0" prefWidth="200.0" alignment="CENTER_LEFT">
          <children>
            <Label prefHeight="-1.0" prefWidth="122.0" styleClass="marca, carrito-titulo" text="Carrito" textAlignment="CENTER" minHeight="-Infinity"/>
            <Region prefHeight="0" prefWidth="0" HBox.hgrow="ALWAYS" minWidth="0">
              <HBox.margin>
                <Insets/>
              </HBox.margin>
            </Region>
            <Label fx:id="lblTotal" prefHeight="-1.0" prefWidth="-1.0" styleClass="marca, carrito-total" text="Total:" minWidth="-Infinity" minHeight="-Infinity"/>
          </children>
        </HBox>
      </children>
    </VBox>
  </top>
</BorderPane>
