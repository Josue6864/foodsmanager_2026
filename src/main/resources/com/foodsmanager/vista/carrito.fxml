<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="950.0" styleClass="contenedor-principal" stylesheets="@tema.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.foodsmanager.controlador.CarritoController">
   <center>
      <ScrollPane fx:id="scrollCarrito" fitToWidth="true" hbarPolicy="NEVER" prefHeight="200.0" prefWidth="200.0" styleClass="scroll-carrito" BorderPane.alignment="CENTER">
         <content>
            <TilePane fx:id="contenedorCarrito" alignment="TOP_CENTER" hgap="18.0" prefColumns="3" prefHeight="395.0" prefRows="2" prefWidth="950.0" styleClass="contenedor-cards-carrito" vgap="18.0" />
         </content>
      </ScrollPane>
   </center>
   <bottom>
      <HBox prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <Region prefHeight="100.0" prefWidth="557.0" />
            <Button fx:id="btnVaciarCarrito" mnemonicParsing="false" onAction="#vaciarCarrito" prefHeight="38.0" prefWidth="157.0" styleClass="boton-eliminar" text="Vaciar carrito" />
            <Region prefHeight="100.0" prefWidth="81.0" />
            <Button fx:id="btnContinuarPago" mnemonicParsing="false" onAction="#continuarPago" styleClass="boton-pagar" text="Continuar al pago" />
         </children>
      </HBox>
   </bottom>
   <top>
      <VBox prefHeight="63.0" prefWidth="950.0" styleClass="encabezado-carrito" BorderPane.alignment="CENTER">
         <children>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Label styleClass="marca" text="FoodsManager" />
                  <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
                  <ComboBox fx:id="cmbNavegacion" onAction="#navegarDesdeMenu" prefWidth="150.0" promptText="Ir a..." styleClass="combo-navegacion" />
               </children>
            </HBox>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Label prefHeight="35.0" prefWidth="122.0" styleClass="marca" text="Carrito" textAlignment="CENTER" />
                  <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                  </Region>
                  <Label fx:id="lblTotal" prefHeight="30.0" prefWidth="219.0" styleClass="marca" text="Total:" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
</BorderPane>
